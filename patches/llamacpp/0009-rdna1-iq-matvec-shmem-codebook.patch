         const int ncols_x, const int nrows_x, const int64_t stride_row_x,
@@ -237,6 +300,10 @@
                 }
             }
         } else {  // IQ2_XXS, IQ3_XXS, IQ3_S: 16 consecutive values per thread
+            __shared__ uint32_t s_grid[lds ? iq_grid_dwords<type>() : 1];
