@@ -186,5 +186,44 @@
         common_debug_print_tensor(data, t->type, t->ne, t->nb, 3, pimpl->abort_on_nan);
     }
 
+    // BC-250 investigation: a plain sum cancels, which hides a diverging node
+    // behind neighbours that agree. Print cancellation-proof statistics so two
+    // runs can be diffed positionally. Enable with GGML_DEBUG_STATS=1.
+    if (getenv("GGML_DEBUG_STATS") && !ggml_is_quantized(t->type) && matches_filter) {
+        const uint8_t * d = is_host ? (const uint8_t *) t->data : pimpl->data.data();
+        const int64_t n = ggml_nelements(t);
+        double sum = 0.0, sumsq = 0.0, maxabs = 0.0;
+        for (int64_t i = 0; i < n; i++) {
+            double v = 0.0;
+            if (t->type == GGML_TYPE_F32) {
+                v = ((const float *) d)[i];
+            } else if (t->type == GGML_TYPE_F16) {
+                v = ggml_fp16_to_fp32(((const ggml_fp16_t *) d)[i]);
+            } else {
+                continue;
+            }
+            sum += v; sumsq += v * v;
+            double a = v < 0 ? -v : v;
+            if (a > maxabs) maxabs = a;
+        }
+        LOG("STATS %s %s n=%lld sum=%.8g sumsq=%.8g maxabs=%.8g\n",
+            t->name, ggml_op_desc(t), (long long) n, sum, sumsq, maxabs);
+
+        // Is the *weight* intact at this moment, or did the output simply not
+        // get written? Byte-level zero check works whatever the quant type.
+        if (src0) {
+            std::vector<uint8_t> w(ggml_nbytes(src0));
+            if (ggml_backend_buffer_is_host(src0->buffer)) {
+                std::copy((const uint8_t *) src0->data, (const uint8_t *) src0->data + w.size(), w.begin());
+            } else {
+                ggml_backend_tensor_get(src0, w.data(), 0, w.size());
+            }
+            size_t nz = 0;
+            for (size_t k = 0; k < w.size(); k++) { if (w[k]) nz++; }
+            LOG("STATSRC %s src0=%s type=%s bytes=%zu nonzero_bytes=%zu\n",
+                t->name, src0->name, ggml_type_name(src0->type), w.size(), nz);
+        }
+    }
+
     return true;
 }
