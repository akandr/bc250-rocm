# ---- 2026-09-18 04:00: D=128 rows 16 and 8, and a correction to the method ----
## The table is first-match-wins. fa_row_sweep.sh inserted candidates after the rows patch 4 already carries, so
## its first pass over D=128 row 64 changed nothing (all five candidate sets printed identical numbers, including
## an nbatch_fa=16 that could not have). The script now replaces an existing row in place; the D=256 and D=512
## sweeps were unaffected because no rows for those sizes existed before them.
## Rows 16 -> (512,3,32,64) and 8 -> (256,4,32,64), which did not exist before, take effect and clear the
## small-batch instances:
flash_attn_tile<128,128,16,1,true>  spill=403 -> 0   vgpr=103  occ=9
flash_attn_tile<128,128,16,1,false> spill=251 -> 0   vgpr=163  occ=6
flash_attn_tile<128,128,8,1,true>   spill=442 -> 0   vgpr=104  occ=9
flash_attn_tile<128,128,8,1,false>  spill=209 -> 0   vgpr=166  occ=6
flash_attn_tile<128,128,1,8,*>      spill=241/207 -> 0  vgpr=102/103  occ=9

