## rows 32,16 -> (512,2,32,64): prefill instances 940 -> 580..609 spilled, 16-column instances 269
flash_attn_tile<512,512,4,8,false>  vgpr=256  spill=609  scratch=2144  (was 940)
flash_attn_tile<512,512,8,4,false>  vgpr=256  spill=609  scratch=2144  (was 940)
