## rows 32,16 -> (512,2,32,32): worse, 630 to 734 on the prefill instances, 315 on ncols 16
## rows 32,16 -> nbatch_fa 16: does not compile (static assertion in fattn-tile.cuh:895)
## D=512 is four times the live state per column of D=128 and does not fit 256 VGPRs at any tile tried.
## rows 32,16 -> (512,2,32,128): the answer for D=512 as well. Prefill instances 940 -> 63..67, ncols 16 -> 0
flash_attn_tile<512,512,4,8,false>  vgpr=256  spill=67   scratch=220   (was 940)
flash_attn_tile<512,512,8,4,false>  vgpr=256  spill=67   scratch=220   (was 940)
